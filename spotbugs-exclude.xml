<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Excluir clases generadas por Spring -->
    <Match>
        <Class name="~.*\$\$SpringCGLIB\$\$.*"/>
    </Match>

    <!-- Excluir la clase principal de aplicación (nombre correcto: Docuflow) -->
    <Match>
        <Class name="com.ingcarlosrubiano.docuflow.DocuflowApplication"/>
    </Match>

    <!-- Excluir DTOs -->
    <Match>
        <Package name="~.*\.dto\..*"/>
    </Match>
</FindBugsFilter>